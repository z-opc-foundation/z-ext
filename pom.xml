<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 消费入口统一走 z-boot-parent（1.0.19 起全组织口径）：继承第三方地板 + import 兄弟仓 fleet
         + Java 8 的 pluginManagement。旧 parent 是 com.zifang:z-opc:1.0.0-SNAPSHOT +
         <relativePath>../pom.xml</relativePath>，而那个路径**不存在**（实测
         `ls z-opc-foundation/pom.xml` = No such file or directory）⇒ 它只在本机 ~/.m2 里读得动，
         换台机器连本仓的 pom 都解析不了；这次迁移修掉的正是这件事。
         relativePath 必须留空：parent 不在磁盘上，在 repo1。 -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.1.0</version>
        <relativePath/>
    </parent>

    <!-- 自家这两格必须显式写出来（以前是从 com.zifang:z-opc 那条幻影 parent 继承的，
         不写就落到新 parent 的 groupId 上，下面三个模块的 parent 会指不回本仓）。
         2026-09-30 CEO 裁定"上到中央仓库"，这一格从"换姓不动"改成真换号：
           groupId com.zifang → io.github.yuku123（与本组织已发布的 26 个仓同一 namespace）
           版本 1.0.0-SNAPSHOT → 1.0.0（Central 不收 SNAPSHOT；repo1 实测 z-ext / z-ext-core /
             z-ext-web / z-ext-frontend 在两个 namespace 下 maven-metadata 全 404 ⇒ 1.0.0 是
             这些坐标的第一个号，不顶掉任何已发布件）
         Java 包名保持 com.zifang.*：换的是 Maven 坐标，不是 namespace（同 z-cache/z-util）。
         原来那句"z-opc 单体也是按 com.zifang:z-ext-core 引用本仓"仍然成立，但那是同一台机器上的
         幻影引用（z-opc 自己的 groupId 也是 com.zifang，且它不在本次发布范围里）⇒ 不构成留着
         旧 namespace 的理由。仓内自家坐标（根 dependencyManagement + 子 pom 的 parent/sibling）
         一起换，全组织 pom grep 实测除 z-opc 副本外没有别的消费者。 -->
    <groupId>io.github.yuku123</groupId>
    <artifactId>z-ext</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <!-- 本仓自己的身份元数据必须自己写：继承链（z-boot-parent → z-boot-dependencies → z-boot 根 pom）
         带着 z-boot 的 description / url / scm，flatten `oss` 又会把父链的 url 一路拼上模块名，
         实测回读到的扁平 pom 里是
         `<description>z-opc-foundation 各仓的统一 parent…</description>` 与
         `<url>https://github.com/z-opc-foundation/z-boot/z-boot-dependencies/z-boot-parent/z-ext</url>`
         —— 那是 z-boot 的身份和一个不存在的 GitHub 路径，发出去等于给本仓的每个构件贴错标签。
         25 个已迁仓（z-cache/z-ctc/z-report…）都是自报这一组字段，同一个口径。
         url/scm 取本仓真实 remote（实测 `git remote -v` = git@github.com:z-opc-foundation/z-ext.git）。 -->
    <name>z-ext</name>
    <description>Java 扩展点框架 (Extension) — 运行时动态注册 / 路由 / 代理调用，用于业务可插拔设计</description>
    <url>https://github.com/z-opc-foundation/z-ext</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- developers 这一格以前没有：flatten(oss) 会把父链的 developers 抄进每份发布 pom，
         父链那格是 z-boot 的身份 ⇒ 自报本仓的（写法与面值同 z-cache/pom.xml、z-meta/pom.xml，
         id/email 与本组织已上中央的 26 个仓逐字一致）。 -->
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-ext.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-ext.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-ext</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-ext-core</module>
        <!-- 前端 Vite/Node 不参与 Maven 发布：dist 拷的是 z-ext-admin/src/main/resources/static
             （已废弃、不在 reactor），留着这条只会让发布构建去 nodejs.org 下 node；
             仓里已提交的 static 资产（git ls-files 实测 6 个文件）不受影响。同做法见 z-config/pom.xml。 -->
        <!-- <module>_frontend</module> -->
        <!-- z-ext-spring-boot-starter 已迁移到 z-boot/z-boot-integration-starters -->
        <!-- z-ext-admin 已废弃: 排除 build, 避免污染 -->
        <module>z-ext-web</module>
    </modules>

    <!-- 版本口径全部由 parent 下发（实测 parent 的父级 z-boot-dependencies 1.0.18→1.0.19
         逐条比过：直接 DM 面值 0 处变化、五条 import 面值一模一样，只掉了 3 条 z-graph 格，
         本仓不引用）。所以这里没有 <properties> 了：
         - maven.compiler.source/target=8、project.build.sourceEncoding=UTF-8：父链同值供给 ⇒ 删。
         - compile.version=8：父链**没有**这一格，它只被本仓 <build> 里那段 maven-compiler-plugin
           的 <source>/<target> 引用；那一段整块删掉后键就没人引用了，由 parent 的 pluginManagement
           下发 3.11.0 / source-target 8 / UTF-8（同 z-report/z-mist 的口径）。
         - util.version=1.0.13：fleet 按坐标管 io.github.yuku123:z-util-core 且面值同为 1.0.13 ⇒ 删。
         实测 parent_preflight 迁后：版本键 0 格、悬空属性 0 格、与父链不同值的键 0 格。
         唯一需要按坐标顶住的是 snakeyaml（面值来自旧父链的直接 DM，不是本仓的键），见下面那条。 -->

    <dependencyManagement>
        <dependencies>
            <!-- 自家 4 个 reactor 坐标钉 ${project.version}（z-boot README「消费模型」步骤 4）。
                 这条不是装饰：继承来的 DM 会改写**传递依赖**的版本，仓外只要有一格存在，
                 旧发布件的字节码就能当 sibling 编进本仓产物。实测 fleet 里没有任何 z-ext 格
                 （repo1 ranged GET：io.github.yuku123:z-ext / z-ext-core 与 com.zifang:z-ext /
                 z-ext-core 的 maven-metadata.xml 全部 404，本仓从未对外发布过）⇒ 这 4 条是登记位，
                 fleet 收了 z-ext 就立刻生效。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-ext</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-ext-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-ext-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-ext-frontend</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
            </dependency>

            <!-- snakeyaml：迁移前基线是 2.0（实测 dependency:tree 那一格，面值来自旧幻影父链
                 com.zifang:z-opc 的**直接** DM 条目，即 monorepo 为 CVE-2022-1471 做的那次抬号），
                 而新父链只从 spring-boot-dependencies 2.7.18 供 1.30（repo1 回读
                 z-boot-dependencies-1.0.19.pom：地板没有 snakeyaml 的直接条目）⇒ 不显式顶住就是
                 静默降版本。按坐标写**直接**条目（z-cache/z-vector/z-gw 同一口径，
                 README「消费模型」步骤 5：import 顶不住继承来的条目，只有直接条目压得住）。 -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>2.0</version>
            </dependency>

            <!-- 2026-09-30：这条 com.zifang:z-rpc-core:${project.version} 删掉，模块侧换成
                 io.github.yuku123:z-rpc-remoting（无版本，由继承来的 parent 下发 fleet 面值 1.0.4）。
                 迁移那一轮在这里留的是"原样钉 ${project.version}，不在迁移里顺手改坐标"，代价是
                 z-ext 的编译只能在本机发生：clean-room 实测
                 Could not find artifact com.zifang:z-rpc-core:jar:1.0.0-SNAPSHOT。
                 换坐标前先比过 jar 类集（这就是"候选换坐标仍需比类集"那把尺）：
                   本机那份 com.zifang:z-rpc-core:1.0.0-SNAPSHOT 里 RpcClient/RpcRequest/RpcResponse
                   在**根包** com.zifang.z.rpc（javap：sendRequest 返回 Object、request 用 setParameters），
                   而 io.github.yuku123:z-rpc-core:1.0.4 只有 cluster/config 两族，这三件早已搬到
                   io.github.yuku123:z-rpc-remoting 的 com.zifang.z.rpc.remoting（sendRequest 直接返回
                   RpcResponse、参数槽叫 setArguments）。⇒ 目标坐标是 z-rpc-remoting 而不是同名同值的
                 z-rpc-core，ZRpcExtInvoker 那三处 import 与两处调用要跟着改（已改，见该文件注释）。 -->

            <!-- 迁移前的 spring-boot-dependencies:${spring-boot.version} import 删掉。
                 ${spring-boot.version} 是旧幻影父链供的键（本仓自己没定义，实测 2.7.18），
                 新 parent 的父级 z-boot-dependencies 1.0.19 自己也 import
                 org.springframework.boot:spring-boot-dependencies:2.7.18（repo1 回读实测，
                 1.0.18→1.0.19 那 5 条 import 面值一模一样）⇒ 版本供给面没有缺口。
                 ⚠ 但这**不是零漂移**的删除，实测得很清楚：本仓那条 import 写在子 pom 里，
                 按 Maven 的 DM 合并顺序它压过了从父链**import 进来**的那些 BOM（floor 的
                 netty-bom / junit-bom / jackson-bom / spring-framework-bom 全部落不到本仓的树上），
                 所以删掉之后这些族回到地板面值：jackson 2.13.5→2.18.6、netty 传递 4.1.101→4.1.138.Final、
                 spring 5.3.31→5.3.39、junit 5.8.2/5.9.2→5.9.3、log4j-api/core 2.17.2→2.25.4
                 （逐条见 dependency:tree 基线对照）。这正是消费模型要的口径统一：第三方面值由地板决定，
                 不由 30 个仓各自 import 一份 Boot BOM 决定；上面 snakeyaml 那一格是唯一要保住的旧值。
                 ⚠ Boot 那 14 条受管项自带的 exclusion 也一起没了（README 步骤 10）：实测迁前/迁后
                 两棵树里 com.mysql:mysql-connector-j 与 com.google.protobuf:protobuf-java 均 0 命中，
                 commons-logging 一族同样无差 ⇒ 本仓不需要照抄 mysql 那条 exclusion。 -->

            <!-- 2026-09-30：这条 com.zifang:z-boot-datasource-starter:${project.version} 删掉。
                 迁移那一轮留它的理由是"删掉会让 z-ext-admin 那份无版本依赖没有落点"，而落点其实
                 一直存在，只是换了坐标：继承来的 parent 按 io.github.yuku123:z-boot-datasource-starter
                 供 1.0.21（repo1 可读），com.zifang 那一格只在本机 ~/.m2 里解析得到。
                 唯一消费者 z-ext-admin 不在任何 reactor 里（<modules> 只有 z-ext-core / _frontend /
                 z-ext-web，见 phantom_dep_census 的 reactor 口径），它的依赖声明已跟着换成
                 io.github.yuku123 那条；留着这格就是给 repo1 上永远 404 的坐标做登记。 -->
        </dependencies>
    </dependencyManagement>
    <dependencies>
    <!-- 全仓统一测试台（parent <dependencies> 直供，所有子模块自动继承，
         子模块一律不再各自声明 junit；版本由根 DM / 地板 junit-bom 统一下发）：
           * junit-jupiter        — JUnit 5 新测试（API + 引擎）
           * junit-vintage-engine — 老 JUnit 4 测试（org.junit.Test）跑在 JUnit 5 平台上 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 本仓把 spring-boot-maven-plugin 钉在 2.7.12，而 parent 的 pluginManagement
                     下发 ${spring-boot.version}=2.7.18（旧幻影父链同样下发 2.7.18，即这一格一直是
                     本仓自己盖在父链前面的）。子 pom 的 pluginManagement 压过继承来的 ⇒ 删掉就
                     等于把 repackage 插件从 2.7.12 抬到 2.7.18，那是另一个决定，不在这里顺手做。
                     使用方只有不在 reactor 里的 z-ext-admin。 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>2.7.12</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- maven-compiler-plugin 那一块（3.11.0 + ${compile.version}）删掉：parent 的
                 pluginManagement 下发同一版本 3.11.0 与 source/target 8 / UTF-8，
                 外加统一的 `-parameters`。3.11.0 与迁移前实测同值，所以只有 -parameters 是新增口径。 -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.17.1</version>
                <configuration>
                    <generateBackupPoms>false</generateBackupPoms>
                </configuration>
            </plugin>

            <!-- 发布形状（README 第 7 步）：z-boot-parent 那条 flatten 声明是
                 <inherited>false</inherited>（repo1 回读 z-boot-parent-1.0.19.pom 实测，它自己用
                 resolveCiFriendliesOnly），**不下发**给消费仓 ⇒ 加了 <parent> 之后必须本仓自己把
                 pom 扁平掉，否则发出去的是带着 org parent 链的 raw pom。
                 判据是本仓对外那侧的形状：repo1 ranged GET 实测 io.github.yuku123:z-ext 与
                 com.zifang:z-ext / z-ext-core / z-ext-web 的 maven-metadata.xml 全部 404，
                 本仓从未对外发布过；而迁移前那份根 pom 唯一的 `<parent>` 就是
                 com.zifang:z-opc:1.0.0-SNAPSHOT 那个幻影件 —— 照原样发出去，任何外部消费者
                 第一次解析就报 "Could not find artifact com.zifang:z-opc:pom:1.0.0-SNAPSHOT"，
                 构件全废 ⇒ 按 z-cache/z-report/z-kb 的口径补 flatten `oss`，发**自包含**的 pom，
                 而不是把幻影 parent 留给未来消费者。
                 常开（不挂 central profile）：挂 profile 时不带 -P central 的 `mvn install`
                 会把带着 z-boot-parent 的 pom 装进本地仓。
                 版本钉 1.5.0：门禁机 250（Maven 3.6.0）实测只有 1.5.0 rc=0，1.6.0/1.7.2 报
                 "requires Maven version 3.6.3"。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.5.0</version>
                <inherited>true</inherited>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- ═══════ 中央发布通道（2026-09-30 CEO 裁定「上到中央仓库」）═══════
         逐件抄 z-cache/pom.xml 的 central profile，插件版本面值一件不改：
         distributionManagement 指 https://central.sonatype.com（server id central 的凭据只在
         ~/.m2/settings.xml，值不落仓）；maven-deploy-plugin 3.1.4 skip=true，上传由
         central-publishing-maven-plugin 0.7.0 接管（tokenAuth + autoPublish + waitUntil=uploaded）；
         maven-source-plugin 3.3.0、maven-javadoc-plugin 3.11.2（doclint=none + failOnError=false）、
         maven-gpg-plugin 3.2.7（passphrase 只从 -Dgpg.passphrase 传，不写进 pom 也不写进命令行历史）。
         发布用 pom 的自包含由上面常开的 flatten(oss) + updatePomFile 负责。 -->
    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                            <!-- Java 口径由 parent 的 pluginManagement 下发（z-cache 这里原先引的是
                                 本仓没定义过的 compile.version，配 failOnError=false 后静默变成无效参数） -->
                            <source>${maven.compiler.source}</source>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                                <arg>--no-tty</arg>
                            </gpgArguments>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <!-- 本插件不认 maven.deploy.skip，没排除的模块照样进 bundle
                                 （实测结论见 z-schedule/pom.xml 同位置注释）⇒ 不可发布的模块点名列出。
                                  · z-ext-web：src 只有 IDEA 占位类 com/zifang/Main.java（打印 Hello and welcome!），0 个扩展点实现 ⇒ 发出去是空壳件
                                  -->
                            <excludeArtifacts>
                                <excludeArtifact>z-ext-web</excludeArtifact>
                                                            <excludeArtifact>z-ext-frontend</excludeArtifact>
                            </excludeArtifacts>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 真发前的形状检查：同一套 distributionManagement，只跳 javadoc 与签名。
             与 central 一起开（-Pcentral,central-dryrun）时后者的 properties 覆盖 skip 两格。 -->
        <profile>
            <id>central-dryrun</id>
            <properties>
                <maven.javadoc.skip>true</maven.javadoc.skip>
                <central.gpg.skip>true</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>
</project>