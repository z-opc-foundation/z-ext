<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-ext</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>z-ext-spring-boot-starter</artifactId>

    <name>z-ext :: spring-boot-starter</name>
    <description>z-ext 自动装配：扩展点注册表接入、SpEL 条件路由、Spring 实例回填、
        嵌入式控制面 HTTP API（/api/ext/**，可开关）。业务应用引入本件即获得
        「能看、能切、能启停」的扩展点介入能力，无需独立部署控制台。</description>

    <dependencies>
        <!-- 框架核心。正常 compile 传递给消费者（z-config / z-oss starter 同口径）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-ext-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 嵌入式控制面是可选能力：spring-webmvc / servlet-api 只在宿主是 servlet
             web 应用时由宿主提供（provided 不传递，业务侧引 spring-boot-starter-web 即可）。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
