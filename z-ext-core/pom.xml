<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-ext</artifactId>
        <version>1.0.1</version>
    </parent>

    <artifactId>z-ext-core</artifactId>

    <name>z-ext-core</name>
    <description>扩展点框架核心：@ExtPoint / @ExtImpl 注解、实现注册表、路由、JDK 动态代理与 z-rpc 远程实现的调用适配</description>

    <dependencies>
        <!-- Spring Context -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Spring Beans -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
        </dependency>

        <!-- Netty for RPC -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <!-- 2026-09-29 迁入统一 parent：这里原本写字面 4.1.138.Final（2026-09-28 从 4.1.65.Final
                 抬上来的那一格），而 parent 的父级 z-boot-dependencies 就是 import
                 io.netty:netty-bom:4.1.138.Final 供同一面值（repo1 回读实测）⇒ 版本删掉、由 DM 下发，
                 面值零漂移。字面版本留在模块里会压过仓根 DM 的一切写法（README「消费模型」步骤 3）。 -->
        </dependency>

        <!-- z-rpc 调用层。坐标是 io.github.yuku123:z-rpc-remoting，不是这里写了几年的
             com.zifang:z-rpc-core：RpcClient/RpcRequest/RpcResponse 在 z-rpc 拆模块之后落在
             remoting 这一件（全限定名 com.zifang.z.rpc.remoting.*），而 repo1 上的
             io.github.yuku123:z-rpc-core:1.0.4 只有 cluster/config 两族 —— 两边类集对照与
             javap 出来的方法差别记在仓根 pom 那条注释里，ZRpcExtInvoker 的 import 与两处调用
             跟着改到 remoting 的形状。
             版本不写字面：fleet 按这个坐标管着，继承来的 parent 下发面值。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-rpc-remoting</artifactId>
        </dependency>

        <!-- z-util-core (com.zifang.util.core.lang.RandomUtil — ZRpcExtInvoker 生成 requestId)。
             此前靠 com.zifang:z-rpc-core 的传递依赖漏进来；z-rpc-core 已安装的 pom 现在无效
             ('dependencies.dependency.version' missing for z-config-client / z-config-common)，
             Maven 直接丢弃它的全部传递依赖，泄漏断掉 → 按 z-lc 9014d38 口径显式声明主线坐标。
             jar 实测：io.github.yuku123:z-util-core:1.0.13 内 RandomUtil 的全限定名仍是
             com.zifang.util.core.lang.RandomUtil，且 520 个 class 的 bytecode major version 全为 52（Java 8）。
             2026-09-29：本仓那份 util.version=1.0.13 键与这里的 <version> 一起删掉 ——
             z-boot-fleet 按坐标管着 io.github.yuku123:z-util-core 且面值同为 1.0.13
             （repo1 回读 z-boot-fleet-1.0.0.pom：<z-util.version>1.0.13</z-util.version>）⇒ 同值可删。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <!-- Jackson for JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- Spring Expression -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-expression</artifactId>
            <!-- 原本写字面 5.3.39。parent 的父级 z-boot-dependencies import 的
                 org.springframework:spring-framework-bom 面值就是 5.3.39（repo1 回读实测，
                 1.0.18 与 1.0.19 同一值）⇒ 同值可删，面值零漂移。 -->
        </dependency>
        <!-- Spring Core (for CachingMetadataReaderFactory) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>
        <!-- Test dependencies -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>