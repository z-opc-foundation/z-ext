<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zifang</groupId>
        <artifactId>z-ext</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>z-ext-core</artifactId>

    <dependencies>
        <!-- Spring Context -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- Spring Beans -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
        </dependency>

        <!-- Netty for RPC -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <!-- 2026-09-28「同坐标单版本」：原钉 4.1.65.Final，抬到 z-boot-dependencies 1.0.18
                 的 netty-bom 口径 4.1.138.Final。z-opc 一个 reactor 里曾因各仓各钉一份解析出 3 套 netty。 -->
            <version>4.1.138.Final</version>
        </dependency>

        <!-- z-rpc-core 依赖 -->
        <dependency>
            <groupId>com.zifang</groupId>
            <artifactId>z-rpc-core</artifactId>
                <version>${project.version}</version>
        </dependency>

        <!-- z-util-core (com.zifang.util.core.lang.RandomUtil — ZRpcExtInvoker 生成 requestId)。
             此前靠 com.zifang:z-rpc-core 的传递依赖漏进来；z-rpc-core 已安装的 pom 现在无效
             ('dependencies.dependency.version' missing for z-config-client / z-config-common)，
             Maven 直接丢弃它的全部传递依赖，泄漏断掉 → 按 z-lc 9014d38 口径显式声明主线坐标。
             jar 实测：io.github.yuku123:z-util-core:1.0.13 内 RandomUtil 的全限定名仍是
             com.zifang.util.core.lang.RandomUtil，且 520 个 class 的 bytecode major version 全为 52（Java 8）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
            <version>${util.version}</version>
        </dependency>

        <!-- Jackson for JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- SLF4J -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <!-- Spring Expression -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-expression</artifactId>
            <version>5.3.39</version>
        </dependency>
        <!-- Spring Core (for CachingMetadataReaderFactory) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>
        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.9.2</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>